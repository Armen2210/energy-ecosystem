# /etc/systemd/system/td_site.service
[Unit]
Description=td_site gunicorn
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/td_site/td_site/backend
Environment="PATH=/var/www/td_site/td_site/backend/.venv/bin"
ExecStart=/var/www/td_site/td_site/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000

[Install]
WantedBy=multi-user.target
