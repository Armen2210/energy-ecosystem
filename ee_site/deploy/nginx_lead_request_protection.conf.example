# TEMPLATE ONLY: merge into the existing EE nginx configuration; do not replace
# unrelated locations, TLS, static, admin or private-document rules.
# These map/zone directives belong in the http {} context, once per nginx host.
map $request_method $ee_lead_limit_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $ee_lead_limit_key zone=ee_lead_burst:10m rate=20r/m;
limit_req_zone $ee_lead_limit_key zone=ee_lead_sustained:10m rate=2r/m;

# The following location belongs in the existing EE server {} block.
location = /api/leads/ {
    # 25 MiB documents + 2 MiB multipart/text overhead. "m" is binary MiB.
    client_max_body_size 27m;
    client_body_timeout 15s;
    proxy_request_buffering on;
    limit_req zone=ee_lead_burst burst=19 nodelay;
    limit_req zone=ee_lead_sustained burst=20 nodelay;
    limit_req_status 429;
    limit_req_log_level warn;

    # Adapt the upstream to the existing Gunicorn Unix socket (recommended)
    # or private loopback listener. Never expose Gunicorn publicly.
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Preserve application JSON errors and Retry-After. nginx's own 429/413 can
    # remain HTML: the frontend handles both. No invented Retry-After for nginx.
    proxy_intercept_errors off;
}
